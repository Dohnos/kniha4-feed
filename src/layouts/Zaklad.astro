---
import "../styles/global.css";
import Hledani from "../components/Hledani.astro";
import { NAZEV_WEBU, POPIS_WEBU, absolutni, odkaz, soubor } from "../lib/web";
import { vygenerovano } from "../lib/knihy";

interface Props {
  titulek?: string;
  popis?: string;
  /** Strukturovaná data schema.org – objekt nebo pole objektů. */
  jsonLd?: object | object[];
  /** Typ stránky pro Open Graph. */
  ogTyp?: "website" | "book";
  /** Aktivní položka navigace. */
  sekce?: "uvod" | "katalog";
}

const { titulek, popis = POPIS_WEBU, jsonLd, ogTyp = "website", sekce } = Astro.props;
const celyTitulek = titulek ? `${titulek} | ${NAZEV_WEBU}` : `${NAZEV_WEBU} – antikvariát, knihy skladem`;
const kanonicka = absolutni(Astro.url.pathname, Astro.site);
const datum = vygenerovano.toLocaleDateString("cs-CZ", { day: "numeric", month: "long", year: "numeric" });
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{celyTitulek}</title>
    <meta name="description" content={popis} />
    <link rel="canonical" href={kanonicka} />
    <link rel="sitemap" href={soubor("sitemap.xml")} />
    <link rel="icon" href={soubor("favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />

    <meta property="og:type" content={ogTyp} />
    <meta property="og:site_name" content={NAZEV_WEBU} />
    <meta property="og:title" content={celyTitulek} />
    <meta property="og:description" content={popis} />
    <meta property="og:url" content={kanonicka} />
    <meta property="og:locale" content="cs_CZ" />

    {
      jsonLd && (
        // "<" escapovat, aby text knihy obsahující "</script>" nemohl ukončit tenhle blok.
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
      )
    }
  </head>
  <body>
    <header class="lista">
      <div class="obal lista-obsah">
        <a class="logo" href={odkaz()} aria-label={`${NAZEV_WEBU} – úvod`}>
          <span class="logo-znak" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
              <path d="M3 5.5h6a3 3 0 0 1 3 3V20a2.5 2.5 0 0 0-2.5-2.5H3z"></path>
              <path d="M21 5.5h-6a3 3 0 0 0-3 3V20a2.5 2.5 0 0 1 2.5-2.5H21z"></path>
            </svg>
          </span>
          {NAZEV_WEBU}
        </a>
        <Hledani />
        <nav class="navigace" aria-label="Hlavní navigace">
          <a class="nav-odkaz" href={odkaz()} aria-current={sekce === "uvod" ? "page" : undefined}>Úvod</a>
          <a class="nav-odkaz" href={odkaz("katalog")} aria-current={sekce === "katalog" ? "page" : undefined}>
            Katalog
          </a>
        </nav>
      </div>
    </header>

    <main class="obal">
      <slot />
    </main>

    <footer class="paticka">
      <div class="obal paticka-obsah">
        <span>© {new Date().getFullYear()} {NAZEV_WEBU} · nabídka aktualizována {datum}</span>
        <span class="paticka-odkazy">
          <a href={odkaz("katalog")}>Katalog</a>
          <a href={soubor("zbozi.xml")}>XML feed</a>
          <a href={soubor("sitemap.xml")}>Mapa webu</a>
        </span>
      </div>
    </footer>
  </body>
</html>
