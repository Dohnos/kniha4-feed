---
import "../styles/global.css";
import Hledani from "../components/Hledani.astro";
import Ikona, { type NazevIkony } from "../components/Ikona.astro";
import { kolekceCen, vygenerovano } from "../lib/knihy";
import { KONTAKT, NAZEV_WEBU, POPIS_WEBU, absolutni, identitaProvozovatele, odkaz, soubor } from "../lib/web";

interface Props {
  titulek?: string;
  popis?: string;
  /** Absolutní adresa obrázku pro sdílení; jinak společný og.png. */
  obrazek?: string;
  jsonLd?: object | object[];
  ogTyp?: "website" | "book";
  sekce?: "uvod" | "katalog" | "autori" | "nakladatele" | "hledat";
  noindex?: boolean;
}

const { titulek, popis = POPIS_WEBU, obrazek, jsonLd, ogTyp = "website", sekce, noindex = false } = Astro.props;
const celyTitulek = titulek ? `${titulek} | ${NAZEV_WEBU}` : `${NAZEV_WEBU} – antikvariát, knihy skladem`;
const kanonicka = absolutni(Astro.url.pathname, Astro.site);
const ogObrazek = obrazek ?? absolutni(soubor("og.png"), Astro.site);
const datum = vygenerovano.toLocaleDateString("cs-CZ", { day: "numeric", month: "long", year: "numeric" });
const NAVIGACE: { sekce: Props["sekce"]; href: string; text: string; ikona: NazevIkony }[] = [
  { sekce: "katalog", href: odkaz("katalog"), text: "Katalog", ikona: "mrizka" },
  { sekce: "autori", href: odkaz("autori"), text: "Autoři", ikona: "autor" },
  { sekce: "nakladatele", href: odkaz("nakladatelstvi"), text: "Nakladatelství", ikona: "nakladatel" },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // Režim nastavit ještě před vykreslením (bez probliknutí). Výchozí je světlý, tmavý si volí návštěvník.
      try {
        const t = localStorage.getItem("tema");
        if (t) document.documentElement.dataset.tema = t;
      } catch {}
    </script>
    <title>{celyTitulek}</title>
    <meta name="description" content={popis} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={kanonicka} />
    <link rel="sitemap" type="application/xml" href={soubor("sitemap.xml")} />
    <link rel="icon" href={soubor("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={soubor("apple-touch-icon.png")} />
    <link rel="manifest" href={soubor("manifest.webmanifest")} />
    <meta name="theme-color" content="#f5f4f0" />

    <meta property="og:type" content={ogTyp} />
    <meta property="og:site_name" content={NAZEV_WEBU} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={celyTitulek} />
    <meta property="og:description" content={popis} />
    <meta property="og:url" content={kanonicka} />
    <meta property="og:image" content={ogObrazek} />
    <meta property="og:image:alt" content={titulek ?? NAZEV_WEBU} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={celyTitulek} />
    <meta name="twitter:description" content={popis} />
    <meta name="twitter:image" content={ogObrazek} />
    <slot name="hlava" />

    {
      jsonLd && (
        // "<" escapovat, aby text knihy s "</script>" nemohl ukončit tenhle blok.
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
      )
    }
  </head>
  <body>
    <header class="lista">
      <div class="obal">
        <div class="lista-obsah">
          <a class="logo" href={odkaz()} aria-label={`${NAZEV_WEBU} – úvod`}>
            <span class="logo-znak"><Ikona nazev="kniha" velikost={19} /></span>
            {NAZEV_WEBU}
          </a>
          <nav class="navigace" aria-label="Hlavní navigace">
            {NAVIGACE.map((n) => <a class="nav-odkaz" href={n.href} aria-current={sekce === n.sekce ? "page" : undefined}>{n.text}</a>)}
          </nav>
          <button class="hledat-tl" type="button" data-hledat aria-label="Hledat (Ctrl+K)">
            <Ikona nazev="hledat" velikost={18} /><span>Hledat knihu…</span><kbd>Ctrl K</kbd>
          </button>
          <button class="lista-tl" type="button" data-tema-prepinac aria-label="Přepnout světlý / tmavý režim" title="Světlý / tmavý režim">
            <Ikona nazev="mesic" velikost={19} class="ikona-mesic" /><Ikona nazev="slunce" velikost={19} class="ikona-slunce" />
          </button>
          <button class="lista-tl menu-tl" type="button" popovertarget="menu" aria-label="Menu">
            <Ikona nazev="menu" velikost={19} />
          </button>
        </div>
      </div>
    </header>

    <div class="menu-panel" id="menu" popover>
      <a href={odkaz()}><Ikona nazev="kniha" /> Úvod</a>
      {NAVIGACE.map((n) => <a href={n.href}><Ikona nazev={n.ikona} /> {n.text}</a>)}
      <a href={odkaz("hledat")}><Ikona nazev="filtr" /> Hledání s filtry</a>
    </div>

    <main>
      <slot />
    </main>

    <footer class="paticka">
      <div class="obal">
        <div class="paticka-mrizka">
          <div>
            <p class="paticka-velky">{NAZEV_WEBU}</p>
            <p>Antikvariát s tisíci knih skladem. Romány, historie, odborná literatura i sběratelské kousky.</p>
            {KONTAKT.email && <p><a href={`mailto:${KONTAKT.email}`}>{KONTAKT.email}</a></p>}
            <p class="paticka-pravni">
              <a href={odkaz("obchodni-podminky")}>Obchodní podmínky</a>
              <a href={odkaz("obchodni-podminky") + "#odstoupeni"}>Odstoupení od smlouvy</a>
              <a href={odkaz("ochrana-osobnich-udaju")}>Ochrana osobních údajů</a>
            </p>
          </div>
          <nav aria-label="Procházet">
            <h2>Procházet</h2>
            <ul>
              <li><a href={odkaz("katalog")}>Celý katalog</a></li>
              <li><a href={odkaz("autori")}>Autoři</a></li>
              <li><a href={odkaz("nakladatelstvi")}>Nakladatelství</a></li>
              <li><a href={odkaz("hledat")}>Hledání s filtry</a></li>
            </ul>
          </nav>
          <nav aria-label="Podle ceny">
            <h2>Podle ceny</h2>
            <ul>{kolekceCen.map((k) => <li><a href={odkaz(`cena/${k.slug}`)}>{k.nazev}</a></li>)}</ul>
          </nav>
        </div>
        <div class="paticka-spodek">
          <span>© {new Date().getFullYear()} {identitaProvozovatele()} · nabídka aktualizována {datum}</span>
          <span><a href={soubor("zbozi.xml")}>XML feed</a> · <a href={soubor("sitemap.xml")}>Mapa webu</a></span>
        </div>
      </div>
    </footer>

    <a class="nahoru" href="#" aria-label="Nahoru"><Ikona nazev="nahoru" /></a>
    <Hledani />

    <script>
      import "../scripts/web.ts";
    </script>
  </body>
</html>
