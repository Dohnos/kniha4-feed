---
import type { GetStaticPaths, Page } from "astro";
import StrankaVypisu from "../../../components/StrankaVypisu.astro";
import { NA_STRANKU, nakladateleSeStrankou, type Kniha, type Skupina } from "../../../lib/knihy";

export const getStaticPaths = (({ paginate }) =>
  nakladateleSeStrankou.flatMap((nakladatel) =>
    paginate(nakladatel.knihy, { params: { slug: nakladatel.slug }, props: { nakladatel }, pageSize: NA_STRANKU })
  )) satisfies GetStaticPaths;

const { page, nakladatel } = Astro.props as { page: Page<Kniha>; nakladatel: Skupina };
const zaklad = `nakladatelstvi/${nakladatel.slug}`;
---

<StrankaVypisu
  nazev={nakladatel.jmeno}
  popis={`Knihy nakladatelství ${nakladatel.jmeno} z nabídky antikvariátu Kniha4U.`}
  page={page}
  zaklad={zaklad}
  drobecky={[{ nazev: "Nakladatelství", cesta: "nakladatelstvi" }, { nazev: nakladatel.jmeno, cesta: zaklad }]}
  sekce="nakladatele"
/>
