---
import type { GetStaticPaths, Page } from "astro";
import StrankaVypisu from "../../components/StrankaVypisu.astro";
import { NA_STRANKU, knihy, type Kniha } from "../../lib/knihy";

// /katalog/ = strana 1, /katalog/2/ … (paginate vyžaduje parametr „page“)
export const getStaticPaths = (({ paginate }) => paginate(knihy, { pageSize: NA_STRANKU })) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Kniha> };
---

<StrankaVypisu
  nazev="Katalog knih"
  popis="Celá nabídka antikvariátu Kniha4U – romány, historie, odborná literatura i sběratelské kousky."
  page={page}
  zaklad="katalog"
  drobecky={[{ nazev: "Katalog", cesta: "katalog" }]}
  filtr
/>
