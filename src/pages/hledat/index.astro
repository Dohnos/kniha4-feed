---
/**
 * Rozšířené hledání – celá nabídka s filtry (FiltrKnih v režimu „hledat“).
 * Stránka je noindex: obsah vzniká až v prohlížeči; pro Google jsou tu katalog a kolekce.
 */
import Zaklad from "../../layouts/Zaklad.astro";
import FiltrKnih from "../../components/FiltrKnih.astro";
import { odkaz } from "../../lib/web";
---

<Zaklad titulek="Hledání knih" popis="Prohledejte celou nabídku podle názvu, autora, nakladatele nebo ISBN a filtrujte podle ceny a doby vydání." sekce="hledat" noindex>
  <div class="obal">
    <header class="vypis-hlava">
      <ol class="drobecky"><li><a href={odkaz()}>Úvod</a></li><li aria-current="page">Hledání</li></ol>
      <h1 class="nadpis-l" style="margin-top: 18px">Hledání knih</h1>
      <p>Celá nabídka na jedné stránce. Kombinujte hledání s cenou, dobou vydání a nakladatelstvím.</p>
    </header>
    <FiltrKnih rezim="hledat" />
  </div>
</Zaklad>
