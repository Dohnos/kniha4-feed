---
/**
 * Obálka knihy: fotka, když ji kniha má, jinak typografická obálka v jedné ze šesti
 * černobílých variant (podle ID). `prechod` zapne plynulý přechod obálky z výpisu do detailu.
 * Fotka je na Cloudinary uložená hotová (WebP, max. 600 × 900 px) – načítá se bez transformací.
 */
import type { Kniha } from "../lib/knihy";

interface Props {
  kniha: Kniha;
  priorita?: boolean;
  prechod?: boolean;
}

const { kniha, priorita = false, prechod = false } = Astro.props;
---

<div class:list={["obalka", `v${kniha.id % 6}`]} style={prechod ? `view-transition-name: obalka-${kniha.id}` : undefined}>
  {
    kniha.obrazek ? (
      <img
        src={kniha.obrazek}
        alt={`Obálka knihy ${kniha.nazev}`}
        loading={priorita ? "eager" : "lazy"}
        decoding="async"
        width="400"
        height="600"
      />
    ) : (
      <>
        <span class="obalka-znacka" aria-hidden="true">Kniha4U</span>
        <span class="obalka-linka" aria-hidden="true" />
        <p class="obalka-nazev" aria-hidden="true">{kniha.nazev}</p>
        {kniha.autor && <span class="obalka-autor" aria-hidden="true">{kniha.autor}</span>}
      </>
    )
  }
</div>
