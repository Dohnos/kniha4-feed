---
import Obalka from "./Obalka.astro";
import { autor, type Kniha } from "../lib/knihy";
import { formatCena, odkaz } from "../lib/web";

interface Props {
  kniha: Kniha;
  priorita?: boolean;
}

const { kniha, priorita } = Astro.props;
const jmeno = autor(kniha);
---

<a class="karta" href={odkaz(`kniha/${kniha.slug}`)}>
  <Obalka kniha={kniha} priorita={priorita} />
  <span class="karta-text">
    <span class="karta-nazev">{kniha.nazev}</span>
    <span class="karta-autor">{jmeno || " "}</span>
    <span class="karta-spodek">
      <span class="karta-rok">{kniha.rok}</span>
      <span class="cena">{formatCena(kniha.cena)}</span>
    </span>
  </span>
</a>
