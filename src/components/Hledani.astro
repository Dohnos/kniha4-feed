---
/**
 * Vyhledávací paleta (Ctrl+K, „/“ nebo tlačítko s `data-hledat`). Rejstřík `hledani.json`
 * se stáhne až při prvním otevření. Logika je v `scripts/web.ts`.
 */
import Ikona from "./Ikona.astro";
import { odkaz, soubor } from "../lib/web";
---

<dialog class="paleta" id="paleta" aria-label="Hledat v nabídce" data-zdroj={soubor("hledani.json")} data-knihy={odkaz("kniha")} data-hledat-stranka={odkaz("hledat")}>
  <form class="paleta-pole" role="search" method="dialog">
    <Ikona nazev="hledat" velikost={22} />
    <input type="search" name="q" placeholder="Název, autor, nakladatel, ISBN…" autocomplete="off" aria-label="Hledat" aria-controls="paleta-vysledky" />
    <button class="paleta-zavrit" type="button" data-zavrit aria-label="Zavřít"><Ikona nazev="zavrit" velikost={18} /></button>
  </form>
  <ul class="paleta-vysledky" id="paleta-vysledky" role="listbox">
    <li class="paleta-info">Začněte psát – hledáme v celé nabídce, na diakritice nezáleží.</li>
  </ul>
  <div class="paleta-pata">
    <span><kbd>↑</kbd> <kbd>↓</kbd> výběr · <kbd>Enter</kbd> otevřít · <kbd>Esc</kbd> zavřít</span>
    <a href={odkaz("hledat")} data-vse>Rozšířené hledání →</a>
  </div>
</dialog>
